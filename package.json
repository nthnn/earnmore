{
  "name": "@nathannestein/earnmore",
  "version": "1.0.0",
  "description": "Closed-loop reward card network library; generates 16-digit PAN, expiry date, and HMAC-based CVV from customer identity data.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nthnn/earnmore.git"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "prepare": "husky",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint:security": "eslint src/**/*.ts",
    "test:security": "npm audit --audit-level=high && npm run lint:security",
    "docs": "typedoc"
  },
  "keywords": [
    "pan",
    "card",
    "cvv",
    "payment",
    "reward",
    "closed-loop"
  ],
  "author": "Nathanne Isip <nathanne@nthnn.dev>",
  "license": "AGPL",
  "type": "module",
  "devDependencies": {
    "@clean-jsdoc-theme/typedoc": "^5.1.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-security": "^4.0.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.1.5",
    "typedoc": "^0.28.20",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.66.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts"
    ]
  }
}